# LLM_PROVIDER: fallback | openai | ollama
LLM_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

YOUTUBE_API_KEY=
YOUTUBE_REGION=IN

# SMTP is disabled by default. Keep dry run enabled for the assignment demo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_DRY_RUN=true
